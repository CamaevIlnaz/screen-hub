# Application
NODE_ENV=development
PORT=5300
API_PREFIX=api
SWAGGER_PATH=docs

# Auth / JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOADS_DIR=uploads

# true: файлы на SFTP; false: локальный UPLOADS_DIR. БД всегда задаётся DATABASE_URL.
SFTP_ENABLED=false
SFTP_HOST=files-server
SFTP_PORT=22
SFTP_USERNAME=user
SFTP_PRIVATE_KEY_PATH=C:/Users/user/.ssh/id_ed25519
SFTP_PASSPHRASE=
SFTP_ROOT=/srv/screen-hub/uploads
SFTP_READY_TIMEOUT_MS=20000

# Собранный фронт (SPA), раздаётся с корня
PUBLIC_DIR=public

# Figma
# Ключ настройки в БД, где хранится Personal Access Token
FIGMA_TOKEN_SETTING_KEY=figma.token
# true: планировщик ежедневной синхронизации стартует вместе с приложением
FIGMA_SYNC_ENABLED=false
# Время ежедневной синхронизации с Figma (HH:mm, часовой пояс сервера)
FIGMA_SYNC_TIME=03:00

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=6400
POSTGRES_USER=screen_hub
POSTGRES_PASSWORD=screen_hub
POSTGRES_DB=screen_hub_proxy
DATABASE_URL=postgresql://screen_hub:screen_hub@localhost:6400/screen_hub_proxy?schema=public
