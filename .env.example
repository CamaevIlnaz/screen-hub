# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_PATH=docs

# Auth / JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOADS_DIR=uploads

# Собранный фронт (SPA), раздаётся с корня
PUBLIC_DIR=public

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=screen_hub
POSTGRES_PASSWORD=screen_hub
POSTGRES_DB=screen_hub_proxy
DATABASE_URL=postgresql://screen_hub:screen_hub@localhost:5432/screen_hub_proxy?schema=public
